{
  "name": "dsh-plugin-project-management",
  "version": "1.2.0",
  "description": "Interview users, then generate and export project timelines / Gantt charts (Word + Excel) in DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "date-holidays": "^3.35.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1 || ^0.1.0-rc.1",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-code-runtime": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
